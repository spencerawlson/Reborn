# Copy to .env next to docker-compose.yml (on the server). Never commit .env.
# Database password: long random letters/digits (no special characters).
POSTGRES_PASSWORD=
# Emails that get the admin role when they sign up or sign in.
ADMIN_EMAILS=
# Host port the site is published on.
APP_PORT=3010
# true once the site is served over HTTPS; false for plain-HTTP access on the LAN.
COOKIE_SECURE=true
