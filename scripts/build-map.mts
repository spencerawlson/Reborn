/**
 * npm run build:map — generates src/components/map-data.ts, the vector
 * outlines for the "Our network" map. Run again only if the map changes.
 *
 * Sources (both Natural Earth, public domain — no attribution required):
 * - world-atlas countries-50m (npm): country borders and coastlines.
 * - data/haiti-departments.geojson: Haiti's 10 departments, extracted from
 *   Natural Earth 1:10m admin-1.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { join } from "node:path";
import { geoMercator, geoPath } from "d3-geo";
import type { FeatureCollection, Geometry } from "geojson";
import { feature } from "topojson-client";

const require = createRequire(import.meta.url);
const ROOT = join(import.meta.dirname, "..");

const world = JSON.parse(readFileSync(require.resolve("world-atlas/countries-50m.json"), "utf8"));
const countries = feature(world, world.objects.countries) as unknown as FeatureCollection<Geometry, { name: string }>;
const departments = JSON.parse(
  readFileSync(join(ROOT, "data", "haiti-departments.geojson"), "utf8"),
) as FeatureCollection<Geometry, { name: string; iso: string }>;

const CITIES = [
  { id: "yul", name: "Montréal", lon: -73.5673, lat: 45.5017 },
  { id: "mia", name: "Miami", lon: -80.1918, lat: 25.7617 },
  { id: "cap", name: "Cap-Haïtien", lon: -72.2003, lat: 19.7578 },
  { id: "pap", name: "Port-au-Prince", lon: -72.3388, lat: 18.5944 },
];

const round = (n: number) => Math.round(n * 10) / 10;

// Main map: eastern North America down to Hispaniola.
const MAIN_W = 560;
const MAIN_H = 640;
const frame = {
  type: "Feature" as const,
  properties: {},
  geometry: {
    type: "MultiPoint" as const,
    coordinates: [
      [-86, 48],
      [-66, 15.2],
    ],
  },
};
const mainProj = geoMercator().fitExtent(
  [
    [0, 0],
    [MAIN_W, MAIN_H],
  ],
  frame,
);
mainProj.clipExtent([
  [0, 0],
  [MAIN_W, MAIN_H],
]);
const mainPath = geoPath(mainProj).digits(1);

const KEEP = new Set([
  "Canada",
  "United States of America",
  "Mexico",
  "Cuba",
  "Haiti",
  "Dominican Rep.",
  "Bahamas",
  "Jamaica",
  "Puerto Rico",
  "Turks and Caicos Is.",
]);
const land = countries.features
  .filter((f) => KEEP.has(f.properties.name))
  .map((f) => ({ name: f.properties.name, d: mainPath(f) ?? "", haiti: f.properties.name === "Haiti" }))
  .filter((c) => c.d.length > 0);

const mainCities = CITIES.map((c) => {
  const [x, y] = mainProj([c.lon, c.lat])!;
  return { id: c.id, name: c.name, x: round(x), y: round(y) };
});

// Haiti inset: the 10 departments with their real borders.
const INSET_W = 360;
const INSET_H = 270;
const insetProj = geoMercator().fitExtent(
  [
    [10, 10],
    [INSET_W - 10, INSET_H - 10],
  ],
  departments,
);
const insetPath = geoPath(insetProj).digits(1);
const insetDepartments = departments.features.map((f) => {
  const [cx, cy] = insetPath.centroid(f);
  return { name: f.properties.name, iso: f.properties.iso, d: insetPath(f) ?? "", cx: round(cx), cy: round(cy) };
});
const insetCities = CITIES.filter((c) => c.id === "cap" || c.id === "pap").map((c) => {
  const [x, y] = insetProj([c.lon, c.lat])!;
  return { id: c.id, name: c.name, x: round(x), y: round(y) };
});

const out = `// GENERATED by scripts/build-map.mts (npm run build:map) — do not edit by hand.
// Natural Earth data (public domain), projected with d3-geo (Mercator).

export const MAIN_MAP = ${JSON.stringify({ width: MAIN_W, height: MAIN_H, land, cities: mainCities })} as const;

export const HAITI_MAP = ${JSON.stringify({ width: INSET_W, height: INSET_H, departments: insetDepartments, cities: insetCities })} as const;
`;
writeFileSync(join(ROOT, "src", "components", "map-data.ts"), out);
console.log(`map-data.ts: ${land.length} countries, ${insetDepartments.length} departments, ${(out.length / 1024).toFixed(1)} KB`);
