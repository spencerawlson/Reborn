# Environment (copy to .env.local; never commit real secrets)
# Postgres connection string for the app database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/haitian_marketplace
# MUST stay false until banking partners, payment providers, and qualified
# legal advisers confirm the Canada-Haiti settlement and payout structure
# is permitted. While false, only mock providers may move money.
LIVE_PAYMENTS_ENABLED=false
# Default commission in basis points (1000 = 10%). Admin changes create a new
# commission_settings row; past orders keep their locked rate.
DEFAULT_COMMISSION_BPS=1000
# Local only: show the admin dashboard without a login (no auth exists yet).
# Ignored when NODE_ENV=production.
ADMIN_DEV_PREVIEW=true
