# Environment (copy to .env.local; never commit real secrets)
# Postgres connection string for the app database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/haitian_marketplace
# MUST stay false until banking partners, payment providers, and qualified
# legal advisers confirm the Canada-Haiti settlement and payout structure
# is permitted. While false, only mock providers may move money.
LIVE_PAYMENTS_ENABLED=false
# Default commission in basis points (1000 = 10%). Admin changes create a new
# commission_settings row; past orders keep their locked rate.
DEFAULT_COMMISSION_BPS=1000
# Comma-separated emails that get the admin role when they sign up or sign in
# (e.g. the founder). Admins can use /admin.
ADMIN_EMAILS=
# Order alerts (email + WhatsApp, best-effort; an order still succeeds if sending fails).
# Email goes to ADMIN_EMAILS via Resend (https://resend.com). Resend's free
# test sender (onboarding@resend.dev) only delivers to your own Resend account
# email; to reach other addresses, verify a sending domain and set NOTIFY_FROM.
RESEND_API_KEY=
NOTIFY_FROM=ShipItAyiti <onboarding@resend.dev>
# WhatsApp via the WhatsApp Business Cloud API. Create a Meta app, a phone
# number, and an approved template (body with 5 placeholders, in order:
# customer, suite, warehouse, store, tracking code), then set these four values.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=order_alert
WHATSAPP_TO=
# Optional base URL used for the admin link in the alert email.
SITE_URL=
# Development: `npm run dev` starts an embedded database (.data/pglite) and sets
# DATABASE_URL automatically — leave it unset locally unless you want another DB.
